{
  "name": "@redhat-cloud-services/i18n-pipeline",
  "version": "0.1.0",
  "description": "Node-based catalog adapters and validation CLI for product UI localization",
  "repository": {
    "type": "git",
    "url": "https://github.com/RedHatInsights/i18n-tooling.git",
    "directory": "packages/i18n-pipeline"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "i18n-pipeline": "./dist/cli.js",
    "frontend-i18n": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/validate-ci.ts --format esm --dts",
    "lint": "tsc --noEmit",
    "pretest": "npm run build --workspace @redhat-cloud-services/eslint-plugin-i18n && npm run build",
    "test": "vitest run",
    "pretest:coverage": "npm run build --workspace @redhat-cloud-services/eslint-plugin-i18n && npm run build",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@redhat-cloud-services/eslint-plugin-i18n": "0.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-formatjs": "8.1.0",
    "import-meta-resolve": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.0.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
