{
  "name": "i18n-tooling",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Shared product UI i18n pipelines and frontend tooling",
  "repository": {
    "type": "git",
    "url": "https://github.com/RedHatInsights/i18n-tooling.git"
  },
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run build --workspace @redhat-cloud-services/eslint-plugin-i18n && eslint .",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,yml,yaml}\"",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "check": "npm run lint && npm run test && npm run build && npm run format:check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.8",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
