{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redhat.com/schemas/i18n-pipeline/phrase-tms-config.json",
  "title": "Phrase TMS workflow configuration",
  "description": "Consumer-repository configuration for reusable Phrase submission and reconciliation workflows. The hcc-ui preset supplies shared project and locale settings. Credentials must be provided as protected workflow secrets; the CLI rejects credential-like keys anywhere in this file.",
  "type": "object",
  "required": ["sourceCatalog"],
  "$defs": {
    "builtInAdapter": {
      "description": "tms submit and tms reconcile run with Phrase and GitHub write credentials, so they load only the CLI's built-in catalog adapters.",
      "enum": ["formatjs-json", "icu-json", "openapi-problem-details"]
    }
  },
  "properties": {
    "preset": {
      "enum": ["hcc-ui"]
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["fr", "ja", "ko", "zh-CN"]
      },
      "description": "Repository locales selected from the named preset, kept in this list's order."
    },
    "targetOutputPath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(/|$)).+$" },
        { "pattern": "\\{locale\\}" }
      ],
      "description": "Repository-relative output path template, with the same path rules as outputPath. The parser substitutes each target's repository locale when outputPath is omitted."
    },
    "provider": {
      "const": "phrase"
    },
    "project": {
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "enum": ["eu", "us"]
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "directory": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
        }
      },
      "additionalProperties": false
    },
    "sourceCatalog": {
      "type": "object",
      "description": "Phrase source catalog settings. For generated FEO source, the template path is the source input while path remains the logical catalog location.",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(/|$)).+$",
          "description": "Logical repository-relative source catalog path. With frontendTemplate.generateSourceCatalog, the source input is frontendTemplate.path; otherwise this file is read from the repository."
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$",
          "description": "Phrase upload filename; defaults to the basename of path. The expected-source-filename workflow pin checks this value and the Phrase jobs. Hub consumers should use a unique filename within the Phrase project."
        },
        "adapter": {
          "$ref": "#/$defs/builtInAdapter"
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        },
        "importSettingsUid": {
          "type": "string",
          "minLength": 1
        },
        "useProjectFileImportSettings": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "targetAdapter": {
      "$ref": "#/$defs/builtInAdapter"
    },
    "targetOptions": {
      "type": "object",
      "additionalProperties": true
    },
    "frontendTemplate": {
      "type": "object",
      "description": "Optional Frontend YAML input. Reconciliation inlines each locale into this file; generateSourceCatalog makes it the Phrase source input.",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(/|$)).+$",
          "description": "Repository-relative Frontend YAML path used for source generation when enabled and for locale inlining during reconciliation."
        },
        "generateSourceCatalog": {
          "type": "boolean",
          "description": "Generate the Phrase source catalog from path on submit and reconciliation instead of reading sourceCatalog.path."
        }
      },
      "additionalProperties": false
    },
    "targetLocales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phraseLocale", "repositoryLocale"],
        "properties": {
          "phraseLocale": {
            "type": "string",
            "minLength": 1
          },
          "repositoryLocale": {
            "type": "string",
            "minLength": 1
          },
          "outputPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
          }
        },
        "additionalProperties": false
      }
    },
    "completionPolicy": {
      "type": "object",
      "description": "Readiness policy for opening locale PRs. Batch completion is separate: a batch completes when each locale has failed or its PR is merged or closed.",
      "properties": {
        "default": {
          "enum": ["per-locale", "all-locales"],
          "default": "per-locale",
          "description": "Readiness policy for target locales without a byLocale override. per-locale opens each ready locale PR independently; all-locales waits until every target locale is ready and blocks sibling PRs if a locale fails. Both policies open one PR per locale."
        },
        "byLocale": {
          "type": "object",
          "additionalProperties": {
            "enum": ["per-locale", "all-locales"],
            "description": "Readiness policy override for this Phrase locale."
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["preset"],
        "properties": {
          "preset": {}
        }
      },
      "then": {
        "anyOf": [
          {
            "required": ["targetOutputPath"],
            "properties": {
              "targetOutputPath": {}
            }
          },
          {
            "required": ["targetLocales"],
            "properties": {
              "targetLocales": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["outputPath"],
                  "properties": { "outputPath": {} }
                }
              }
            }
          }
        ]
      },
      "else": {
        "required": ["provider", "project", "targetLocales"],
        "properties": {
          "provider": {},
          "project": {
            "type": "object",
            "required": ["uid", "region"],
            "properties": {
              "uid": {},
              "region": {}
            }
          },
          "sourceCatalog": {
            "type": "object",
            "required": ["adapter", "locale"],
            "properties": {
              "adapter": {},
              "locale": {}
            }
          },
          "targetLocales": {}
        }
      }
    },
    {
      "if": {
        "required": ["locales"],
        "properties": {
          "locales": {}
        }
      },
      "then": {
        "required": ["preset"],
        "properties": {
          "preset": {}
        },
        "not": {
          "type": "object",
          "required": ["targetLocales"],
          "properties": { "targetLocales": {} }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": ["targetOutputPath"],
          "properties": { "targetOutputPath": {} }
        }
      },
      "then": {
        "properties": {
          "targetLocales": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["outputPath"],
              "properties": { "outputPath": {} }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["frontendTemplate"],
        "properties": {
          "frontendTemplate": { "type": "object" }
        }
      },
      "then": {
        "properties": {
          "sourceCatalog": {
            "type": "object",
            "properties": {
              "adapter": { "const": "formatjs-json" },
              "locale": { "const": "en" }
            }
          },
          "targetLocales": {
            "type": "array",
            "maxItems": 32,
            "description": "At most 32 locales, the Frontend operator's per-Frontend spec.locales limit.",
            "items": {
              "type": "object",
              "properties": {
                "repositoryLocale": {
                  "type": "string",
                  "description": "Becomes a key of spec.locales, so it must be a canonical BCP 47 locale id (language, optional script, optional region, such as fr, zh-CN or zh-Hant-TW) other than en. Matches the Frontend operator CRD rule; the CLI also rejects deprecated aliases such as iw (use he). phraseLocale may keep Phrase's own code, such as zh_cn.",
                  "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
                  "not": { "const": "en" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
