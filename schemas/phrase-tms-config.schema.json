{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redhat.com/schemas/frontend-i18n/phrase-tms-config.json",
  "title": "Phrase TMS workflow configuration",
  "description": "Consumer-repository configuration for reusable Phrase submission and reconciliation workflows. Credentials must be provided as protected workflow secrets; the CLI rejects credential-like keys anywhere in this file.",
  "type": "object",
  "required": ["provider", "project", "sourceCatalog", "targetLocales"],
  "properties": {
    "provider": {
      "const": "phrase"
    },
    "project": {
      "type": "object",
      "required": ["uid", "region"],
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "enum": ["eu", "us"]
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "directory": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
        }
      },
      "additionalProperties": false
    },
    "sourceCatalog": {
      "type": "object",
      "required": ["path", "adapter", "locale"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        },
        "importSettingsUid": {
          "type": "string",
          "minLength": 1,
          "description": "Select a reusable Phrase import-settings record for this job; sent as importSettings.uid. For ICU JSON, configure fileImportSettings.json.icuSubFilter to true. Mutually exclusive with useProjectFileImportSettings and ensureJsonIcuImportSettings."
        },
        "ensureJsonIcuImportSettings": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Base name for the reusable ICU-enabled job import-settings record; a settings fingerprint is appended."
            }
          },
          "additionalProperties": false,
          "description": "Copy project file-import settings, select JSON explicitly, enable Parse ICU messages, then reuse an identical reusable record or create one if missing. Mutually exclusive with importSettingsUid and useProjectFileImportSettings."
        },
        "useProjectFileImportSettings": {
          "type": "boolean",
          "description": "Use the Phrase project's file-import settings for this job instead of API defaults. This is distinct from a reusable job import-settings record selected with importSettingsUid. Mutually exclusive with importSettingsUid and ensureJsonIcuImportSettings."
        }
      },
      "additionalProperties": false
    },
    "targetAdapter": {
      "type": "string",
      "minLength": 1
    },
    "targetOptions": {
      "type": "object",
      "additionalProperties": true
    },
    "targetLocales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phraseLocale", "repositoryLocale", "outputPath"],
        "properties": {
          "phraseLocale": {
            "type": "string",
            "minLength": 1
          },
          "repositoryLocale": {
            "type": "string",
            "minLength": 1
          },
          "outputPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
          }
        },
        "additionalProperties": false
      }
    },
    "completionPolicy": {
      "type": "object",
      "properties": {
        "default": {
          "enum": ["per-locale", "all-locales"],
          "default": "per-locale"
        },
        "byLocale": {
          "type": "object",
          "additionalProperties": {
            "enum": ["per-locale", "all-locales"]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
